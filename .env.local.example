# ESP32 API base URL (e.g. http://192.168.1.100 or http://esp32-campus.local)
# Leave empty or remove to use JSON fallback only
NEXT_PUBLIC_ESP32_API_URL=

# Data mode: "auto" (try API then fallback to JSON), "api" (API only), "json" (JSON only)
NEXT_PUBLIC_DATA_MODE=auto

# API request timeout in milliseconds
NEXT_PUBLIC_API_TIMEOUT_MS=3000

# How often to re-check if API is available (ms)
NEXT_PUBLIC_API_HEALTH_CHECK_INTERVAL_MS=30000

# Sensor data polling interval (ms)
NEXT_PUBLIC_SENSOR_POLL_INTERVAL_MS=30000
